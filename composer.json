{
    "name": "polygonlab/identifiants-entreprise-fr",
    "description": "Validation des SIREN, SIRET, TVA intracommunautaire et codes APE, avec les nomenclatures NAF rév. 2 et NAF 2025.",
    "type": "library",
    "license": "MIT",
    "keywords": ["php", "siren", "siret", "tva", "naf", "ape", "sirene", "insee", "numero-tva", "entreprise", "vat", "validation", "france", "naf-2025", "code-ape"],
    "homepage": "https://github.com/polygonlab-ai/identifiants-entreprise-fr",
    "authors": [
        {
            "name": "PolygonLab",
            "email": "contact@polygonlab.ai",
            "homepage": "https://polygonlab.ai"
        }
    ],
    "support": {
        "issues": "https://github.com/polygonlab-ai/identifiants-entreprise-fr/issues",
        "source": "https://github.com/polygonlab-ai/identifiants-entreprise-fr",
        "security": "https://github.com/polygonlab-ai/identifiants-entreprise-fr/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpoffice/phpspreadsheet": "^5.11",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PolygonLab\\IdentifiantsEntreprise\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PolygonLab\\IdentifiantsEntreprise\\Tests\\": "tests/",
            "PolygonLab\\IdentifiantsEntreprise\\Tools\\": "tools/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style-corriger": "php-cs-fixer fix",
        "donnees-naf": "php tools/generer-donnees-naf.php"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
